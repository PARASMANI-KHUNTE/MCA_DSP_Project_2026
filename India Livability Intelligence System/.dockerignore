# Keep the build context small and platform-clean.
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.ruff_cache

# Frontend is built in its own stage; never ship host node_modules/dist.
frontend/node_modules
frontend/dist

# Heavy / irrelevant for the containers
notebooks
reports
data/raw/*
!data/raw/source_register.csv
data/interim/*

*.log
